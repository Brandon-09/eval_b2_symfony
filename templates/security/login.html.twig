{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="narrow">
        <div class="card">
            <h1>Connexion</h1>

            {% if error %}
                <div class="flash flash-error">
                    Email ou mot de passe incorrect.
                </div>
            {% endif %}

            {% for message in app.flashes('success') %}
                <div class="flash flash-success">
                    {{ message }}
                </div>
            {% endfor %}

            <form class="form" method="post" action="{{ path('app_login') }}">

                <div>
                    <label for="username">Email</label>
                    <input
                        type="email"
                        id="username"
                        name="_username"
                        value="{{ last_username }}"
                        autocomplete="email"
                        required
                        autofocus
                    >
                </div>

                <div>
                    <label for="password">Mot de passe</label>
                    <input
                        type="password"
                        id="password"
                        name="_password"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <input
                    type="hidden"
                    name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >

                <button type="submit">
                    Se connecter
                </button>

            </form>

            <p class="form-footer">
                Pas encore de compte ?
                <a href="{{ path('app_register') }}">
                    Créer un compte
                </a>
            </p>
        </div>
    </div>
{% endblock %}
