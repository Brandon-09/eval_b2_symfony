{% extends 'base.html.twig' %}

{% block title %}Ajouter un événement{% endblock %}

{% block body %}
    <div class="narrow">
        <a class="back-link" href="{{ path('app_home') }}">
            ← Retour aux événements
        </a>

        <div class="card">
            <h1>Ajouter un événement</h1>

            <p class="muted">
                Votre événement sera visible après validation par un administrateur.
            </p>

            {{ form_start(form, {'attr': {'class': 'form'}}) }}

                <div>
                    {{ form_label(form.title) }}
                    {{ form_widget(form.title, {
                        'attr': {
                            'placeholder': 'Ex. : Soirée jazz au Kiosque'
                        }
                    }) }}
                    {{ form_errors(form.title) }}
                </div>

                <div>
                    {{ form_label(form.date) }}
                    {{ form_widget(form.date) }}
                    {{ form_errors(form.date) }}
                </div>

                <div>
                    {{ form_label(form.information) }}
                    {{ form_widget(form.information, {
                        'attr': {
                            'placeholder': 'Lieu, programme, tarif...'
                        }
                    }) }}
                    {{ form_errors(form.information) }}
                </div>

                <div>
                    {{ form_label(form.category) }}
                    {{ form_widget(form.category) }}
                    {{ form_errors(form.category) }}
                </div>

                <div>
                    {{ form_label(form.maxPlaces) }}
                    {{ form_widget(form.maxPlaces, {
                        'attr': {
                            'min': 1
                        }
                    }) }}
                    {{ form_errors(form.maxPlaces) }}
                </div>

                <div>
                    {{ form_label(form.imageFile) }}
                    {{ form_widget(form.imageFile, {
                        'attr': {
                            'accept': 'image/jpeg,image/png,image/webp'
                        }
                    }) }}
                    {{ form_errors(form.imageFile) }}

                    <div class="help-text">
                        JPG, PNG ou WebP.
                    </div>
                </div>

                {{ form_errors(form) }}

                <button type="submit">
                    Enregistrer l'événement
                </button>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
