{% extends 'base.html.twig' %}

{% block title %}Événements à venir{% endblock %}

{% block body %}
    <section class="hero" style="background-image: url('{{ asset('images/rock.jpg') }}')">
        <div class="hero-content">
            <span class="hero-kicker">Agenda local</span>
            <h1>Les événements près de chez vous</h1>
            <p>Concerts, conférences, ateliers et sport : trouvez votre prochaine sortie ou proposez la vôtre.</p>
            <a class="btn" href="{{ path('app_event_new') }}">+ Ajouter un événement</a>
        </div>
    </section>

    <div class="section-head">
        <h2>À venir</h2>
        <ul class="legend">
            <li><a class="{{ categorie is empty ? 'active' : '' }}" href="{{ path('app_home') }}">Toutes</a></li>
            <li class="cat-concert"><a class="{{ categorie == 'concert' ? 'active' : '' }}" href="{{ path('app_home', {categorie: 'concert'}) }}">Concert</a></li>
            <li class="cat-conference"><a class="{{ categorie == 'conference' ? 'active' : '' }}" href="{{ path('app_home', {categorie: 'conference'}) }}">Conférence</a></li>
            <li class="cat-atelier"><a class="{{ categorie == 'atelier' ? 'active' : '' }}" href="{{ path('app_home', {categorie: 'atelier'}) }}">Atelier</a></li>
            <li class="cat-sport"><a class="{{ categorie == 'sport' ? 'active' : '' }}" href="{{ path('app_home', {categorie: 'sport'}) }}">Sport</a></li>
        </ul>
    </div>

    <ul class="event-list">
        {% for event in events %}
            <li class="event-card cat-{{ event.category|lower }}">
                <div class="event-media">

                    {% if event.image %}
                        <img class="event-image"
                             src="{{ asset('uploads/events/' ~ event.image) }}"
                             alt="{{ event.title }}">
                    {% else %}
                        <img class="event-image"
                             src="{{ asset('images/' ~ event.category|lower ~ '.jpg') }}"
                             alt="{{ event.title }}">
                    {% endif %}

                    <div class="event-date">
                        <span class="day">{{ event.date|date('d') }}</span>
                        <span class="month">{{ event.date|date('M')|lower }}</span>
                    </div>

                    <span class="badge">{{ event.category|capitalize }}</span>
                </div>

                <h3 class="event-title">
                    <a href="{{ path('app_event_show', {id: event.id}) }}">
                        {{ event.title }}
                    </a>
                </h3>

                <span class="muted">
                    {{ event.date|date('d/m/Y · H\\hi') }}
                </span>
            </li>
        {% else %}
            <p class="empty">Aucun événement à venir pour le moment.</p>
        {% endfor %}
    </ul>
{% endblock %}
